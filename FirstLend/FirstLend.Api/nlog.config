<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="logs/internal-nlog.txt">

  <!-- Enable ASP.NET Core layout renderers -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- Define log targets -->
  <targets>
    <!-- File Target for all logs -->
    <target xsi:type="File" 
            name="allfile" 
            fileName="logs/firstlend-all-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId:whenEmpty=0}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />

    <!-- File Target for errors only -->
    <target xsi:type="File" 
            name="errorfile" 
            fileName="logs/firstlend-errors-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId:whenEmpty=0}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}|${callsite}" />

    <!-- File Target for exceptions with full stack trace -->
    <target xsi:type="File" 
            name="exceptionfile" 
            fileName="logs/firstlend-exceptions-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId:whenEmpty=0}|${level:uppercase=true}|${logger}|${message}${newline}${exception:format=ToString,StackTrace}${newline}url: ${aspnet-request-url}${newline}action: ${aspnet-mvc-action}${newline}user: ${aspnet-user-identity}${newline}" />

    <!-- Console Target for development -->
    <target xsi:type="Console" 
            name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=message}" />
  </targets>

  <!-- Define logging rules -->
  <rules>
    <!-- Log all to console in development -->
    <logger name="*" minlevel="Info" writeTo="console" />
    
    <!-- Log everything to all file -->
    <logger name="*" minlevel="Trace" writeTo="allfile" />

    <!-- Log errors and above to error file -->
    <logger name="*" minlevel="Error" writeTo="errorfile" />
    
    <!-- Log exceptions with full details -->
    <logger name="*" minlevel="Error" writeTo="exceptionfile" />

    <!-- Skip Microsoft logs (too verbose) -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
  </rules>
</nlog>
